{
    "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "resourceGroupName": {
            "type": "string",
            "defaultValue": "rg-jit-azaccess",
            "metadata": { "description": "Name of the resource group to create and deploy into." }
        },
        "location": {
            "type": "string",
            "metadata": { "description": "Azure region for all resources (e.g. eastus, westeurope)." }
        },
        "appName": {
            "type": "string",
            "defaultValue": "pgjitazaccess",
            "maxLength": 15,
            "metadata": {
                "description": "Short lowercase alphanumeric identifier (3-15 chars, no hyphens) used to derive all resource names. E.g. 'pgjitazaccess' produces func-pgjitazaccess, key-pgjitazaccess, etc."
            }
        },
        "azureTrayAppRegistrationName": {
            "type": "string",
            "defaultValue": "AzureTray",
            "metadata": {
                "description": "Display name of the AzureTray host app registration. Informational only; used by deployment scripts. profile.ps1 uses the object ID below to PATCH notes."
            }
        },
        "azureTrayAppRegistrationObjectId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Object ID (NOT appId/clientId) of the AzureTray host app registration. Used by the function app to PATCH its jit-baseurl:<sub>=<url> tag onto the app reg on cold start. Required because the function app's MI holds Application.ReadWrite.OwnedBy, which permits reading/writing the specific app you own but not listing /applications. Deploy.ps1 resolves and supplies this automatically."
            }
        },
        "allowedDurationsHours": {
            "type": "string",
            "defaultValue": "1,4,8",
            "metadata": { "description": "Comma-separated list of allowed JIT durations in hours that callers may request." }
        },
        "nsgPriorityMin": {
            "type": "string",
            "defaultValue": "1000",
            "metadata": { "description": "Lowest NSG rule priority the JIT app may use (1000-4096)." }
        },
        "nsgPriorityMax": {
            "type": "string",
            "defaultValue": "3900",
            "metadata": { "description": "Highest NSG rule priority the JIT app may use (must be > nsgPriorityMin)." }
        },
        "maxRulesPerCaller": {
            "type": "string",
            "defaultValue": "5",
            "metadata": { "description": "Maximum number of simultaneously active JIT rules a single caller identity may hold." }
        },
        "maxRulesPerResource": {
            "type": "string",
            "defaultValue": "20",
            "metadata": { "description": "Maximum number of simultaneously active JIT rules on a single target resource." }
        },
        "logAnalyticsWorkspaceId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Resource ID of an existing Log Analytics workspace to back the Application Insights component. REQUIRED in practice: the app runs from a package, which disables filesystem log streaming, so App Insights is the only place its logs land. Leave empty only if you are deliberately deploying an app you cannot observe."
            }
        }
    },
    "variables": {
        "storageName":  "[format('st{0}', parameters('appName'))]",
        "planName":     "[format('asp-{0}', parameters('appName'))]",
        "functionName": "[format('func-{0}', parameters('appName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Resources/resourceGroups",
            "apiVersion": "2022-09-01",
            "name": "[parameters('resourceGroupName')]",
            "location": "[parameters('location')]",
            "properties": {}
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "jit-azaccess-resources",
            "resourceGroup": "[parameters('resourceGroupName')]",
            "dependsOn": [
                "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
            ],
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": { "scope": "inner" },
                "parameters": {
                    "location":                   { "value": "[parameters('location')]" },
                    "appName":                      { "value": "[parameters('appName')]" },
                    "storageName":                  { "value": "[variables('storageName')]" },
                    "planName":                     { "value": "[variables('planName')]" },
                    "functionName":                 { "value": "[variables('functionName')]" },
                    "azureTrayAppRegistrationName":     { "value": "[parameters('azureTrayAppRegistrationName')]" },
                    "azureTrayAppRegistrationObjectId": { "value": "[parameters('azureTrayAppRegistrationObjectId')]" },
                    "allowedDurationsHours":        { "value": "[parameters('allowedDurationsHours')]" },
                    "nsgPriorityMin":               { "value": "[parameters('nsgPriorityMin')]" },
                    "nsgPriorityMax":               { "value": "[parameters('nsgPriorityMax')]" },
                    "maxRulesPerCaller":            { "value": "[parameters('maxRulesPerCaller')]" },
                    "maxRulesPerResource":          { "value": "[parameters('maxRulesPerResource')]" },
                    "logAnalyticsWorkspaceId":      { "value": "[parameters('logAnalyticsWorkspaceId')]" }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "location":                   { "type": "string" },
                        "appName":                      { "type": "string" },
                        "storageName":                  { "type": "string" },
                        "planName":                     { "type": "string" },
                        "functionName":                 { "type": "string" },
                        "azureTrayAppRegistrationName":     { "type": "string" },
                        "azureTrayAppRegistrationObjectId": { "type": "string" },
                        "allowedDurationsHours":        { "type": "string" },
                        "nsgPriorityMin":               { "type": "string" },
                        "nsgPriorityMax":               { "type": "string" },
                        "maxRulesPerCaller":            { "type": "string" },
                        "maxRulesPerResource":          { "type": "string" },
                        "logAnalyticsWorkspaceId":      { "type": "string" }
                    },
                    "variables": {
                        "insightsName":   "[format('appi-{0}', parameters('appName'))]",
                        "packageContainer": "deployments",
                        "packageBlob":      "functionapp.zip",
                        "packageUrl":     "[format('https://{0}.blob.core.windows.net/deployments/functionapp.zip', parameters('storageName'))]",
                        "storageId":      "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageName'))]"
                    },
                    "resources": [
                        {
                            "type": "Microsoft.Storage/storageAccounts",
                            "apiVersion": "2022-09-01",
                            "name": "[parameters('storageName')]",
                            "location": "[parameters('location')]",
                            "sku": { "name": "Standard_LRS" },
                            "kind": "StorageV2",
                            "properties": {
                                "supportsHttpsTrafficOnly": true,
                                "minimumTlsVersion": "TLS1_2",
                                "allowBlobPublicAccess": false,
                                "allowSharedKeyAccess": false,
                                "networkAcls": {
                                    "defaultAction": "Allow",
                                    "bypass": "AzureServices"
                                }
                            }
                        },
                        {
                            "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
                            "apiVersion": "2022-09-01",
                            "name": "[format('{0}/default/{1}', parameters('storageName'), variables('packageContainer'))]",
                            "dependsOn": [ "[variables('storageId')]" ],
                            "properties": { "publicAccess": "None" }
                        },
                        {
                            "type": "Microsoft.Insights/components",
                            "apiVersion": "2020-02-02",
                            "name": "[variables('insightsName')]",
                            "location": "[parameters('location')]",
                            "kind": "web",
                            "properties": {
                                "Application_Type": "web",
                                "WorkspaceResourceId": "[if(empty(parameters('logAnalyticsWorkspaceId')), json('null'), parameters('logAnalyticsWorkspaceId'))]"
                            }
                        },
                        {
                            "type": "Microsoft.Web/serverfarms",
                            "apiVersion": "2022-03-01",
                            "name": "[parameters('planName')]",
                            "location": "[parameters('location')]",
                            "kind": "functionapp",
                            "sku": { "name": "Y1", "tier": "Dynamic" },
                            "properties": {}
                        },
                        {
                            "type": "Microsoft.Web/sites",
                            "apiVersion": "2022-03-01",
                            "name": "[parameters('functionName')]",
                            "location": "[parameters('location')]",
                            "kind": "functionapp",
                            "identity": { "type": "SystemAssigned" },
                            "dependsOn": [
                                "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
                                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageName'))]",
                                "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageName'), 'default', variables('packageContainer'))]",
                                "[resourceId('Microsoft.Insights/components', variables('insightsName'))]"
                            ],
                            "properties": {
                                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
                                "httpsOnly": true,
                                "siteConfig": {
                                    "minTlsVersion": "1.2",
                                    "ftpsState": "Disabled",
                                    "powerShellVersion": "7.2",
                                    "cors": { "allowedOrigins": [], "supportCredentials": false },
                                    "appSettings": [
                                        { "name": "AzureWebJobsStorage__accountName",       "value": "[parameters('storageName')]" },
                                        { "name": "WEBSITE_RUN_FROM_PACKAGE",              "value": "[variables('packageUrl')]" },
                                        {
                                            "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                                            "value": "[reference(resourceId('Microsoft.Insights/components', variables('insightsName')), '2020-02-02').ConnectionString]"
                                        },
                                        { "name": "FUNCTIONS_EXTENSION_VERSION",           "value": "~4" },
                                        { "name": "FUNCTIONS_WORKER_RUNTIME",              "value": "powershell" },
                                        { "name": "ALLOWED_DURATIONS_HOURS",               "value": "[parameters('allowedDurationsHours')]" },
                                        { "name": "JIT_TABLE_NAME",                        "value": "JITRules" },
                                        { "name": "JIT_NSG_PRIORITY_MIN",                  "value": "[parameters('nsgPriorityMin')]" },
                                        { "name": "JIT_NSG_PRIORITY_MAX",                  "value": "[parameters('nsgPriorityMax')]" },
                                        { "name": "JIT_MAX_RULES_PER_CALLER",              "value": "[parameters('maxRulesPerCaller')]" },
                                        { "name": "JIT_MAX_RULES_PER_RESOURCE",            "value": "[parameters('maxRulesPerResource')]" },
                                        { "name": "AZURETRAY_APP_REGISTRATION_NAME",         "value": "[parameters('azureTrayAppRegistrationName')]" },
                                        { "name": "AZURETRAY_APP_REGISTRATION_OBJECT_ID",    "value": "[parameters('azureTrayAppRegistrationObjectId')]" }
                                    ]
                                }
                            }
                        }
                    ],
                    "outputs": {
                        "functionAppPrincipalId": {
                            "type": "string",
                            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionName')), '2022-03-01', 'full').identity.principalId]"
                        },
                        "functionAppName": {
                            "type": "string",
                            "value": "[parameters('functionName')]"
                        },
                        "functionAppHostname": {
                            "type": "string",
                            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionName')), '2022-03-01').defaultHostName]"
                        },
                        "storageAccountName": {
                            "type": "string",
                            "value": "[parameters('storageName')]"
                        },
                        "packageContainer": {
                            "type": "string",
                            "value": "[variables('packageContainer')]"
                        },
                        "packageBlob": {
                            "type": "string",
                            "value": "[variables('packageBlob')]"
                        }
                    }
                }
            }
        }
    ],
    "outputs": {
        "functionAppPrincipalId": {
            "type": "string",
            "value": "[reference('jit-azaccess-resources').outputs.functionAppPrincipalId.value]"
        },
        "functionAppName": {
            "type": "string",
            "value": "[reference('jit-azaccess-resources').outputs.functionAppName.value]"
        },
        "functionAppHostname": {
            "type": "string",
            "value": "[reference('jit-azaccess-resources').outputs.functionAppHostname.value]"
        },
        "resourceGroupName": {
            "type": "string",
            "value": "[parameters('resourceGroupName')]"
        },
        "storageAccountName": {
            "type": "string",
            "value": "[reference('jit-azaccess-resources').outputs.storageAccountName.value]"
        },
        "packageContainer": {
            "type": "string",
            "value": "[reference('jit-azaccess-resources').outputs.packageContainer.value]"
        },
        "packageBlob": {
            "type": "string",
            "value": "[reference('jit-azaccess-resources').outputs.packageBlob.value]"
        }
    }
}
