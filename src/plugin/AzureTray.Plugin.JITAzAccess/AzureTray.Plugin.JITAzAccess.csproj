<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <PackageId>Proxylayer.AzureTray.Plugin.JITAzAccess</PackageId>
    <!--
      Single source of truth for the plugin version. Drives:
        - The .nupkg filename (PackageVersion)
        - AssemblyVersion / FileVersion / AssemblyInformationalVersion
        - The string the plugin reports to the host at runtime
          (via JitAzAccessPlugin.Version, which reads AssemblyInformationalVersion).
    -->
    <Version>0.3.0</Version>
    <PackageDescription>
      JIT (Just-in-Time) Azure IP access plugin for AzureTray.
      Grants temporary firewall rules on NSG, Azure SQL Server, Storage Accounts,
      and Key Vaults directly from the system tray by calling a JIT-AzAccess
      function app backend.
    </PackageDescription>
    <!--
      proxylayer.azuretray-plugin is the discovery tag the host queries on
      nuget.org. Without it the package won't appear in Browse online plugins.
    -->
    <PackageTags>proxylayer.azuretray-plugin;jit;azure;firewall;nsg;sql;storage;keyvault</PackageTags>

    <!--
      Bundle transitive NuGet runtime DLLs into the .nupkg so the host can
      resolve them when it extracts and loads the plugin.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackTransitiveAssets</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets="all" is mandatory: the host loads its OWN copy of the
      contracts assembly into a collectible AssemblyLoadContext. Shipping a
      transitive dependency on it would cause duplicate type loads and break
      the ITrayPlugin cast.

      Using a ProjectReference during development so changes to the contracts
      are picked up immediately. Switch back to PackageReference before
      publishing by pointing at the released NuGet version.
    -->
    <PackageReference Include="AzureTray.Plugin.Contracts" Version="1.3.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackTransitiveAssets">
    <ItemGroup>
      <!-- RuntimeCopyLocalItems lists NuGet-resolved runtime DLLs. -->
      <BuildOutputInPackage Include="@(RuntimeCopyLocalItems)" />
    </ItemGroup>
  </Target>

</Project>
