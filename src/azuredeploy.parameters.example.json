{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "value": "eastus"
        },
        "appName": {
            "value": "jitazaccess"
        },
        "resourceGroupName": {
            "value": "rg-jit-azaccess"
        },
        "azureTrayAppRegistrationName": {
            "value": "AzureTray"
        },
        "azureTrayAppRegistrationObjectId": {
            "value": "<object ID of the AzureTray app registration — fill in or leave blank to let Deploy.ps1 resolve it>"
        },
        "jitRequesterRoleName": {
            "value": "JIT Requester"
        },
        "allowedDurationsHours": {
            "value": "1,4,8"
        },
        "nsgPriorityMin": {
            "value": "1000"
        },
        "nsgPriorityMax": {
            "value": "3900"
        },
        "maxRulesPerCaller": {
            "value": "5"
        },
        "maxRulesPerResource": {
            "value": "20"
        }
    }
}
